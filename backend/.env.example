# Copiar a .env (o exportar las variables). Para desarrollo local no hace falta nada.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Base de datos (vacío = SQLite). Ejemplo MySQL:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=market
# DB_USER=market
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# --- Pagos ---
FRONTEND_URL=http://localhost:8081
BACKEND_PUBLIC_URL=http://127.0.0.1:8000   # URL pública (https) del backend; Mercado Pago la usa para webhooks/OAuth
PLATFORM_FEE_PERCENT=0                     # comisión de la plataforma en %
# Mercado Pago: crear una aplicación en https://www.mercadopago.com.ar/developers y copiar:
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_USE_SANDBOX_URL=False
PAYMENTS_ENCRYPTION_KEY=
